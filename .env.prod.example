# Production secrets — cp to .env.prod and fill in. NEVER commit .env.prod.
POSTGRES_USER=careeros
POSTGRES_PASSWORD=
POSTGRES_DB=careeros

S3_ACCESS_KEY=careeros
S3_SECRET_KEY=

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

GEMINI_API_KEY=

# Optional — Referral Engine (public GitHub people discovery). A read-only PAT
# (no scopes; github.com/settings/tokens) lifts the rate limit from 60 to
# 5000/hr. Works without it, just slower/limited.
GITHUB_TOKEN=

# Optional — real India job volume via the Adzuna aggregator API (free key at
# developer.adzuna.com → register an app). Without it the daily sweep no-ops.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble aggregator — free key at jooble.org/api/about (~500 requests/day)
JOOBLE_API_KEY=

# Optional until you create the bot (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_SCORE=70

# Frontend origin once deployed
CORS_ORIGIN=http://localhost:3000
