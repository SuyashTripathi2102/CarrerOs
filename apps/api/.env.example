DATABASE_URL="postgresql://careeros:careeros@localhost:5432/careeros?schema=public"
PORT=3001
# Interface the API listens on. Empty means 127.0.0.1 (this machine only). Only an IP
# address or "localhost" is accepted; anything else stops the API from starting. Set
# 0.0.0.0 (every interface) only inside a container or behind a firewall you control.
HOST=""
# Sign-up is open only until the first account exists. "true" keeps it open to anyone
# who can reach the API, and every account can use every feature, crawls and AI calls
# included: leave it empty unless that is what you want.
ALLOW_REGISTRATION=""
CORS_ORIGIN="http://localhost:3000"
# Public address of the web app, for links inside Telegram messages. Leave empty
# while it only runs on localhost: Telegram rejects messages that link there.
DASHBOARD_URL=""

# AI spending, in recorded USD per UTC day (see apps/api/src/modules/ai/spend-policy.ts).
# Background work, embeddings included, stops AI_INTERACTIVE_RESERVE_USD short of the budget so
# your own actions still work. AI_CREDIT_EXPIRES_AT is required: YYYY-MM-DD (00:00 UTC that day)
# or YYYY-MM-DDTHH:MM with Z or +HH:MM; missing or invalid, every AI call is refused. From then on
# the post-credit budget applies; missing, invalid or 0 (the default), it refuses every AI call.
AI_DAILY_BUDGET_USD="8"
AI_INTERACTIVE_RESERVE_USD="0.25"
AI_CREDIT_EXPIRES_AT=""
AI_DAILY_BUDGET_AFTER_CREDIT_USD="0"
REDIS_URL="redis://localhost:6379"

# Auth — generate a real secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Object storage (MinIO locally — matches docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="careeros"
S3_SECRET_KEY="careeros123"
S3_BUCKET="careeros"

# Service-to-service auth (workers/scraper -> API internal endpoints)
INTERNAL_API_TOKEN="change-me-shared-secret"

# AI (Gemini — Phase 5) — get one at https://aistudio.google.com
GEMINI_API_KEY="change-me"
# Optional — Referral Engine public GitHub discovery. Read-only PAT (no scopes)
# lifts the rate limit 60 -> 5000/hr. github.com/settings/tokens
GITHUB_TOKEN=""
# Default vendor for both workloads. Override per-workload with LLM_PROVIDER /
# EMBEDDING_PROVIDER when the two are served by different vendors (embeddings
# and generation have separate markets — see modules/ai/llm.provider.ts).
AI_PROVIDER="gemini"
# LLM_PROVIDER="gemini"          # or "vertex"
# EMBEDDING_PROVIDER="gemini"    # or "vertex"

# Vertex AI (only when a provider above is "vertex") — see docs/VERTEX_MIGRATION.md
# GOOGLE_CLOUD_PROJECT="my-project-id"
# GOOGLE_CLOUD_LOCATION="us-central1"
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
# VERTEX_TEXT_MODEL="gemini-3.5-flash"        # defaults to GEMINI_TEXT_MODEL
# VERTEX_EMBEDDING_MODEL="gemini-embedding-2" # defaults to GEMINI_EMBEDDING_MODEL
# VERTEX_EMBED_BATCH_SIZE=1
GEMINI_TEXT_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIMS=1536
# After exhausted 429 retries, fail AI calls fast for this long instead of
# hammering a dead quota (default 10 min)
# AI_QUOTA_COOLDOWN_MS=600000

# Notifications (Phase C) — create a bot via @BotFather; message it once, then
# GET https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# How "✓ Applied" taps reach CareerOS. "polling" asks Telegram for them
# (getUpdates) and needs no public URL; run one API process in that mode.
# Empty or "webhook" uses /api/telegram/webhook plus TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_INBOUND=""
TELEGRAM_WEBHOOK_SECRET=""
NOTIFY_MIN_SCORE=70

# Company-crawl retirement drop guard: off (default) or on. On, a complete crawl
# that sees fewer than half as many jobs as the company's previous valid crawl
# retires nothing that time, and the next crawl decides. Needs the crawl_runs
# complete/reconciled columns; without them it stays off. Read at startup.
RETIREMENT_DROP_GUARD=off
